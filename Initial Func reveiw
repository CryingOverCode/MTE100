void initSD() {
  if (!Brain.SDcard.isInserted()) {
    Brain.Screen.print("No SD card found");
    return;
  }

  string base = "Point_Scan_V";
  string type = ".txt";
  int n = 1;
  string current_name = base + to_string(n) + type;
  while (Brain.SDcard.exists(current_name.c_str())) {
    n++;
    current_name = base + to_string(n) + type;
  }

  c_file_name = current_name;

  const char* header = "x_mm y_mm";
  Brain.SDcard.savefile(c_file_name.c_str(), (uint8_t*)header, strlen(header));
}

void flushToSD() {
  for (int i = 0; i < buffer_count; i++) {
    Point p = buffer[i];
    char line[20];   // two numbers so 20 must be large enough, can lower value
    int len = snprintf(line, sizeof(line), "%d %d\n", p.x_mm, p.y_mm);
    Brain.SDcard.appendfile(c_file_name.c_str(), (uint8_t*)line, len);
  }
  buffer_count = 0;
}

void bufferWrite(const Point& p) {
  buffer[buffer_count] = p;

  if (++buffer_count >= BUF_SIZE) {
    flushToSD();
  }
}

void scanPlananrPoint(float maximum_angle, float speed){

  PitchM.setMaxTorque(100, percent);
  PitchM.spin(reverse);
  if (PitchM.velocity(rpm) > 0.2){
    setMaxTorque(5, percent); // so it keeps it in pos
  }

  float max_motor_pos = maximum_angle * HORIZ_GEAR_RATIO;

  //determining whether  going to left or right endstop is faster
  HorizM.setVelocity(100, rpm);
  
  if (HorizM.position(degrees) > 0){
    HorizM.spin(forward);
    
    while (HorizM.position(degrees) < max_motor_pos){ wait(5, msec); }
    HorizM.stop(brake);
    max_motor_pos *= -1;
  
  } else{
    
    HorizM.spin(reverse);
    
    while (HorizM.position(degrees) > -max_motor_pos){ wait(5, msec); }
    HorizM.stop(brake);
  }

  HorizM.setVelocity(speed, rpm);
  bool going_positive = max_motor_pos > 0;
  
  if (going_positive){
    HorizM.spin(forward);
  } else{
    HorizM.spin(reverse);
  }
  
  timer distance_reading_countdown;
  int now;
    
  while ((going_positive && HorizM.position(degrees) < max_motor_pos) || (!going_positive && HorizM.position(degrees) > max_motor_pos)){
    if (distance_reading_countdown.time(msec) >= DISTANCE_INTERVAL_MS){
      
      distance_reading_countdown.reset();
      
      Point p = {};
      
      p.dist_mm = (uint16_t)Dist.objectDistance(mm);
      
      p.horiz_enc_cdeg = (int16_t)((HorizM.position(degrees) * 100) / float(HORIZ_GEAR_RATIO)); // *100 convert to centidegrees.
      p.pitch_enc_cdeg = (int16_t)((PitchM.position(degrees) * 100) / float(PITCH_GEAR_RATIO));
      
      now = globalTime.time(msec);
      
      p.t_lo = now & 0xFFFF;
      p.t_hi = now >> 16;
      
      pointCoords(robotPos(), p.horiz_enc_cdeg, p.pitch_enc_cdeg, p.dist_mm, p.x_mm, p.y_mm); // does not exist yet---------------------------------- <<<<<<<<
      
      bufferWrite(p);
    }
  }
  HorizM.stop(brake);
  
  flushToSD(); // write the partial buffer at the end
}

