{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor HorizM = motor(PORT1, false);\nmotor PitchM = motor(PORT2, false);\ndistance Dist = distance(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include <iostream>\n#include <math.h>\n#include <cstdint>\n#include <cstddef>\n\nusing namespace std;\nusing namespace vex;\n\n//Global\ntimer globalTime;\nstring c_file_name;\n\n//\nconst float DISTANCE_INTERVAL_MS = pow(30, -1) * 1000; // 30 Hz max\nconst size_t BUF_SIZE = 64; // 64 readings * 26 bytes -> 1664 bytes per buffer. ~ 2.13s of data before a SDcard flush\nconst size_t HORIZ_GEAR_RATIO = 4;\nconst size_t PITCH_GEAR_RATIO = 30;\n\n\nstruct Point { // 26 Bytes per reading\n  int16_t x_mm;\n  int16_t y_mm;\n\n  uint16_t t_lo;   // t_ms & 0xFFFF\n  uint16_t t_hi;   // t_ms >> 16\n  // time split in two so that the compiling wont need to pad memory to 28 bytes\n\n  uint16_t dist_mm;\n  int16_t horiz_enc_cdeg;\n  int16_t pitch_enc_cdeg;\n  int16_t bot_x_mm;\n  int16_t bot_y_mm;\n  int16_t bot_z_mm;\n  int16_t heading_cdeg;\n  int16_t pitch_cdeg;\n  int16_t roll_cdeg;\n};\n\nPoint buffer[BUF_SIZE];\nint16_t buffer_count = 0;\n\n// Prototypes so main() can call functions defined below it\nvoid initSD();\nvoid flushToSD();\nvoid bufferWrite(const Point& p);\nvoid scanPlananrPoint(float maximum_angle, float speed);\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // Begin project code\n  \n}\n\nvoid initSD() {\n  if (!Brain.SDcard.isInserted()) {\n    Brain.Screen.print(\"No SD card found\");\n    return;\n  }\n\n  string base = \"Point_Scan_V\";\n  string type = \".txt\";\n  int n = 1;\n  string current_name = base + to_string(n) + type;\n  while (Brain.SDcard.exists(current_name.c_str())) {\n    n++;\n    current_name = base + to_string(n) + type;\n  }\n\n  c_file_name = current_name;\n\n  const char* header = \"x_mm y_mm\";\n  Brain.SDcard.savefile(c_file_name.c_str(), (uint8_t*)header, strlen(header));\n}\n\nvoid flushToSD() {\n  for (int i = 0; i < buffer_count; i++) {\n    Point p = buffer[i];\n    char line[20];   // two numbers so 20 must be large enough, can lower value\n    int len = snprintf(line, sizeof(line), \"%d %d\\n\", p.x_mm, p.y_mm);\n    Brain.SDcard.appendfile(c_file_name.c_str(), (uint8_t*)line, len);\n  }\n  buffer_count = 0;\n}\n\nvoid bufferWrite(const Point& p) {\n  buffer[buffer_count] = p;\n\n  if (++buffer_count >= BUF_SIZE) {\n    flushToSD();\n  }\n}\n\nvoid scanPlananrPoint(float maximum_angle, float speed){\n\n  PitchM.setMaxTorque(100, percent);\n  PitchM.spin(reverse);\n  if (PitchM.velocity(rpm) > 0.2){\n    setMaxTorque(5, percent); // so it keeps it in pos\n  }\n\n  float max_motor_pos = maximum_angle * HORIZ_GEAR_RATIO;\n\n  //determining whether  going to left or right endstop is faster\n  HorizM.setVelocity(100, rpm);\n  \n  if (HorizM.position(degrees) > 0){\n    HorizM.spin(forward);\n    \n    while (HorizM.position(degrees) < max_motor_pos){ wait(5, msec); }\n    HorizM.stop(brake);\n    max_motor_pos *= -1;\n  \n  } else{\n    \n    HorizM.spin(reverse);\n    \n    while (HorizM.position(degrees) > -max_motor_pos){ wait(5, msec); }\n    HorizM.stop(brake);\n  }\n\n  HorizM.setVelocity(speed, rpm);\n  bool going_positive = max_motor_pos > 0;\n  \n  if (going_positive){\n    HorizM.spin(forward);\n  } else{\n    HorizM.spin(reverse);\n  }\n  \n  timer distance_reading_countdown;\n  int now;\n    \n  while ((going_positive && HorizM.position(degrees) < max_motor_pos) || (!going_positive && HorizM.position(degrees) > max_motor_pos)){\n    if (distance_reading_countdown.time(msec) >= DISTANCE_INTERVAL_MS){\n      \n      distance_reading_countdown.reset();\n      \n      Point p = {};\n      \n      p.dist_mm = (uint16_t)Dist.objectDistance(mm);\n      \n      p.horiz_enc_cdeg = (int16_t)((HorizM.position(degrees) * 100) / float(HORIZ_GEAR_RATIO)); // *100 convert to centidegrees.\n      p.pitch_enc_cdeg = (int16_t)((PitchM.position(degrees) * 100) / float(PITCH_GEAR_RATIO));\n      \n      now = globalTime.time(msec);\n      \n      p.t_lo = now & 0xFFFF;\n      p.t_hi = now >> 16;\n      \n      pointCoords(robotPos(), p.horiz_enc_cdeg, p.pitch_enc_cdeg, p.dist_mm, p.x_mm, p.y_mm); // does not exist yet---------------------------------- <<<<<<<<\n      \n      bufferWrite(p);\n    }\n  }\n  HorizM.stop(brake);\n  \n  flushToSD(); // write the partial buffer at the end\n}\n\nvoid scanPoint(float maximum_angle, float speed){\n\n  PitchM.setMaxTorque(100, percent);\n  PitchM.spin(forward);\n  if (PitchM.velocity(rpm) > 0.2){\n    setMaxTorque(5, percent); // so it keeps it in pos\n  }\n  \n\n  float max_motor_pos = maximum_angle * HORIZ_GEAR_RATIO;\n\n\n  //determining whether  going to left or right endstop is faster\n  HorizM.setVelocity(100, rpm);\n  \n  if (HorizM.position(degrees) > 0){\n    HorizM.spin(forward);\n    \n    while (HorizM.position(degrees) < max_motor_pos){ wait(5, msec); }\n    HorizM.stop(brake);\n    max_motor_pos *= -1;\n  \n  } else{\n    \n    HorizM.spin(reverse);\n    \n    while (HorizM.position(degrees) > -max_motor_pos){ wait(5, msec); }\n    HorizM.stop(brake);\n  }\n\n  HorizM.setVelocity(speed, rpm);\n  bool going_positive = max_motor_pos > 0;\n  \n  if (going_positive){\n    HorizM.spin(forward);\n  } else{\n    HorizM.spin(reverse);\n  }\n  \n  timer distance_reading_countdown;\n  int now;\n    \n  while ((going_positive && HorizM.position(degrees) < max_motor_pos) || (!going_positive && HorizM.position(degrees) > max_motor_pos)){\n    if (distance_reading_countdown.time(msec) >= DISTANCE_INTERVAL_MS){\n      \n      distance_reading_countdown.reset();\n      \n      Point p = {};\n      \n      p.dist_mm = (uint16_t)Dist.objectDistance(mm);\n      \n      p.horiz_enc_cdeg = (int16_t)((HorizM.position(degrees) * 100) / float(HORIZ_GEAR_RATIO)); // *100 convert to centidegrees.\n      p.pitch_enc_cdeg = (int16_t)((PitchM.position(degrees) * 100) / float(PITCH_GEAR_RATIO));\n      \n      now = globalTime.time(msec);\n      \n      p.t_lo = now & 0xFFFF;\n      p.t_hi = now >> 16;\n      \n      pointCoords(robotPos(), p.horiz_enc_cdeg, p.pitch_enc_cdeg, p.dist_mm, p.x_mm, p.y_mm); // does not exist yet---------------------------------- <<<<<<<<\n      \n      bufferWrite(p);\n    }\n  }\n  HorizM.stop(brake);\n  \n  flushToSD(); // write the partial buffer at the end\n}","textLanguage":"cpp","robotConfig":[{"port":[1],"name":"HorizM","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"PitchM","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[3],"name":"Dist","customName":true,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}